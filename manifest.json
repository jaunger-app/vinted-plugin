{
  "manifest_version": 3,
  "name": "Vinted Käufe – Übersicht",
  "version": "2.8.6",
  "description": "Vinted-Käufe und -Verkäufe als Reseller-Übersicht mit automatischer Aktualisierung, Gewinn, Versand-Details und CSV-Export.",
  "permissions": ["scripting", "storage", "unlimitedStorage", "cookies", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.vinted.de/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://localhost:3000/*", "https://jucreative.de/*", "https://www.jucreative.de/*"], "js": ["webapp-bridge.js"], "run_at": "document_end" }
  ],
  "action": {
    "default_title": "Meine Vinted-Käufe",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
